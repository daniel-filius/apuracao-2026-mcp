# Só o bot Telegram (opcional) precisa disto. O servidor MCP não usa nenhuma credencial.
# Token gerado no @BotFather. Sem esta variável, `apuracao-bot` sai imediatamente (dormente).
APURACAO_BOT_TOKEN=

# Opcional: caminho do arquivo .env a ser lido por `apuracao-bot` (linha exata APURACAO_BOT_TOKEN=...).
# APURACAO_ENV_FILE=/caminho/para/.env

# Opcional: onde gravar as métricas anônimas do bot (padrão: ./metrics.jsonl).
# APURACAO_METRICS_PATH=metrics.jsonl
